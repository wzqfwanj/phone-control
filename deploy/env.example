# phone-control 服务端环境变量示例
#
# 部署时由 deploy/push.ps1 复制为 /opt/phone-control/.env（真实文件不入库），
# 首次部署会自动生成随机 CONTROL_DEVICE_KEY（openssl rand -hex 16）。
# 改完 .env 后执行 systemctl restart phone-control 生效。
#
# 服务只监听回环地址；公网流量由 frp 隧道（dev 127.0.0.1:8090 → aliyun 127.0.0.1:18090）
# 和 Caddy（https://wkeeli.cn/control/ 与 wss://wkeeli.cn/agent/）接入，不要改成 0.0.0.0。

# 监听地址（保持回环）
CONTROL_HOST=127.0.0.1

# 监听端口（必须与 deploy/frpc.snippet.toml 的 localPort 一致）
CONTROL_PORT=8090

# 设备配对码：手机 App 里填这个值；留空则拒绝所有设备连接（服务端返回 401）。
# 生成方式：openssl rand -hex 16
CONTROL_DEVICE_KEY=

# 前端产物目录（相对 WorkingDirectory=/opt/phone-control，也可写绝对路径）
CONTROL_STATIC_DIR=web/dist
